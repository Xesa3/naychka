<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PhotoFilter">

    <LinearLayout
        android:id="@+id/LL2"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/photoView"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:text="Выберите фильтр"
            android:textColor="#040404"
            android:textSize="16sp"

            android:maxLines="10"

            android:layout_marginStart="20dp"
            android:layout_marginEnd="60dp"

            android:fontFamily="sans-serif-black"
            />

        <Button
            android:id="@+id/btnBackToPatientDetails"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"

            android:layout_marginEnd="10dp"

            android:backgroundTint="#5CBDD3"
            android:text="@string/btn_back"
            android:textColor="@color/white"
            android:textSize="18sp"

            android:maxLines="2"
            android:gravity="center"
            />


    </LinearLayout>

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@+id/LL2"
        app:layout_constraintBottom_toTopOf="@+id/LL1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="1.0" />




    <LinearLayout
        android:id="@+id/LL1"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photoView">




        <Button
            android:id="@+id/btnSaveCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:backgroundTint="#4CAF50"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="10dp"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="23dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="200dp"
            android:text="@string/btn_save"
            android:textColor="@android:color/white"
            android:textSize="18sp" />


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filtersList"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintTop_toBottomOf="@id/photoView"
        app:layout_constraintBottom_toTopOf="@id/LL1"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>